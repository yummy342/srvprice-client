{
  "id": "aliyun.add_pub_record",
  "version": 1,
  "status": "draft",
  "vendor": "aliyun",
  "title": "阿里云：给 example.com 加 pub A 记录",
  "entry": "https://dnsnext.console.aliyun.com/authoritative/domains/example.com",
  "variables": {},
  "steps": [
    {
      "step_id": "open_records",
      "do": { "action": "open", "url": "https://dnsnext.console.aliyun.com/authoritative/domains/example.com", "new_tab": true },
      "verify": { "text": "主机记录", "timeout_ms": 25000 },
      "fail_when": { "text": "请登录" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "fill_rr",
      "do": { "action": "real_type", "match": { "label": "请输入主机记录" }, "value": "pub" },
      "verify": { "text": "记录值", "timeout_ms": 8000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "type_rr_at",
      "do": { "action": "type_at", "x": 647, "y": 252, "value": "pub" },
      "verify": { "text": "记录值", "timeout_ms": 8000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "save_add",
      "do": { "action": "dom_click", "text": "确定" },
      "verify": { "text": "解析变更确认|添加记录", "timeout_ms": 12000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "modal_confirm2",
      "do": { "action": "click_at", "x": 908, "y": 417 },
      "verify": { "text": "解析设置", "timeout_ms": 12000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "press_esc",
      "do": { "action": "press_key", "key": "Escape" },
      "verify": { "text": "记录值", "timeout_ms": 6000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "dismiss_tip",
      "do": { "action": "click_at", "x": 1150, "y": 300 },
      "verify": { "text": "记录值", "timeout_ms": 6000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "fill_val",
      "do": { "action": "real_type", "match": { "label": "请输入记录值" }, "value": "203.0.113.10" },
      "verify": { "text": "确定", "timeout_ms": 8000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "click_add",
      "do": { "action": "dom_click", "text": "添加记录" },
      "verify": { "text": "主机记录", "timeout_ms": 12000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    }
  ]
}
