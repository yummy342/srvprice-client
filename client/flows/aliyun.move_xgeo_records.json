{
  "id": "aliyun.move_xgeo_records",
  "version": 1,
  "status": "draft",
  "vendor": "aliyun",
  "title": "阿里云：把 example.com 的 @/www/pub 指向目标主机",
  "entry": "https://dnsnext.console.aliyun.com/authoritative/domains/example.com",
  "variables": {},
  "steps": [
    {
      "step_id": "open_xgeo",
      "do": { "action": "open", "url": "https://dnsnext.console.aliyun.com/authoritative/domains/example.com", "new_tab": true },
      "verify": { "text": "主机记录", "timeout_ms": 25000 },
      "fail_when": { "text": "请登录" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "check_pub2",
      "do": { "action": "check_row", "text": "2026年11月12日 00:56:58" },
      "verify": { "text": "修改记录值", "timeout_ms": 8000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "check_at2",
      "do": { "action": "check_row", "text": "2026年9月18日 12:16:48" },
      "verify": { "text": "修改记录值", "timeout_ms": 8000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "check_www2",
      "do": { "action": "check_row", "text": "2026年9月18日 12:16:36" },
      "verify": { "text": "修改记录值", "timeout_ms": 8000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "check_pub",
      "do": { "action": "click_at", "x": 254, "y": 332 },
      "verify": { "text": "主机记录", "timeout_ms": 6000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "check_at",
      "do": { "action": "click_at", "x": 254, "y": 404 },
      "verify": { "text": "主机记录", "timeout_ms": 6000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "check_www",
      "do": { "action": "click_at", "x": 254, "y": 440 },
      "verify": { "text": "主机记录", "timeout_ms": 6000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "batch_modify2",
      "do": { "action": "real_click", "match": { "text": "修改记录值" } },
      "verify": { "text": "记录值", "timeout_ms": 12000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "fill_batch",
      "do": { "action": "real_type", "match": { "label": "请输入记录值" }, "value": "203.0.113.10" },
      "verify": { "text": "确定", "timeout_ms": 8000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "batch_modify",
      "do": { "action": "click_at", "x": 773, "y": 548 },
      "verify": { "text": "记录值|修改记录值", "timeout_ms": 12000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "click_row6",
      "do": { "action": "click_at", "x": 960, "y": 400 },
      "verify": { "text": "记录值", "timeout_ms": 12000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "edit_at",
      "do": { "action": "row_click", "row_text": "@", "button_text": "修改" },
      "verify": { "text": "记录值", "timeout_ms": 12000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "edit_www",
      "do": { "action": "row_click", "row_text": "www", "button_text": "修改" },
      "verify": { "text": "记录值", "timeout_ms": 12000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "edit_pub",
      "do": { "action": "row_click", "row_text": "pub", "button_text": "修改" },
      "verify": { "text": "记录值", "timeout_ms": 12000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "fill_target_host",
      "do": { "action": "real_type", "match": { "near_text": "记录值集合" }, "value": "203.0.113.10" },
      "verify": { "text": "确定", "timeout_ms": 8000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "save_dlg",
      "do": { "action": "dom_click", "text": "确定" },
      "verify": { "text": "解析变更确认|解析设置", "timeout_ms": 12000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "modal_ok",
      "do": { "action": "click_at", "x": 908, "y": 417 },
      "verify": { "text": "解析设置", "timeout_ms": 12000 },
      "fail_when": { "text": "无权限" },
      "human": false,
      "sensitive": false
    }
  ]
}
