{
  "id": "aliyun.view_accesskeys",
  "version": 1,
  "status": "draft",
  "vendor": "aliyun",
  "title": "阿里云：查看现有 AccessKey 列表（只读）",
  "entry": "https://ram.console.aliyun.com/profile/access-keys",
  "preconditions": [
    "已登录阿里云主账号",
    "当前标签是 AccessKey 页面"
  ],
  "steps": [
    {
      "step_id": "ack_warning",
      "do": {
        "action": "check_by_label",
        "label": "我确认知晓"
      },
      "verify": {
        "text": "AccessKey",
        "timeout_ms": 10000
      },
      "fail_when": {
        "text": "请登录|无权限"
      },
      "human": false,
      "sensitive": false
    },
    {
      "step_id": "continue_account_key",
      "do": {
        "action": "click",
        "match": {
          "text": "继续使用云账号 AccessKey"
        }
      },
      "verify": {
        "text": "AccessKey",
        "timeout_ms": 10000
      },
      "fail_when": {
        "text": "请登录|无权限"
      },
      "human": false,
      "sensitive": false
    }
  ],
  "postconditions": [
    "AccessKey 列表可见"
  ]
}
